# One .env file per running instance — one instance per organization.
# API_KEY is required on every request's Authorization: Bearer header
# (see ApiKeyGuard / ARCHITECTURE.md's "Key decisions" #10/#11) —
# generate a real random value per instance, don't reuse this placeholder.

MSP_ID=BLCFounderMSP
PEER_ENDPOINT=localhost:7051
PEER_TLS_ROOTCERT_PATH=../network/crypto/organizations/BLCFounder/peers/peer0/tls/ca.pem
ADMIN_CERT_PATH=../network/crypto/organizations/BLCFounder/users/Admin/msp/signcerts/cert.pem
ADMIN_KEYSTORE_DIR=../network/crypto/organizations/BLCFounder/users/Admin/msp/keystore/
CHANNEL_NAME=blcchannel
INSTITUTION_CC_NAME=institution-cc
CERTIFICATE_CC_NAME=certificate-cc
HTTP_PORT=3001
API_KEY=replace-with-a-real-random-secret-per-instance
