# Slack App ("AI SDLC Pipeline Bot") - Basic Information > App-Level Tokens
# ("Generate Token and Scopes" -> add connections:write -> Generate).
# Authenticates the outbound Socket Mode WebSocket connection itself - this
# service has no inbound HTTP server and no port to bind.
SLACK_APP_TOKEN=

# Slack App - OAuth & Permissions > Bot User OAuth Token (xoxb-...)
# Requires channels:history + chat:write (public channels) AND
# groups:history (private channels - channels:history alone does NOT
# cover these, confirmed live 2026-08-17: conversations.history/events
# both fail with channel_not_found on a private channel without it).
# reactions:write is also required for the confirmation checkmark
# (confirmed live 2026-08-17: reactions.add fails with missing_scope
# without it - easy to miss since the relay itself still succeeds).
# The bot must ALSO be invited as an actual channel member, separately
# from any of the above - a channel it can already post into via an
# older incoming-webhook integration is NOT the same as bot membership,
# and event delivery/history reads only work for channels it's a member
# of.
SLACK_BOT_TOKEN=

# The PM's Slack member ID - same value already used by requirements-nudge.yml
# as the PM_SLACK_MEMBER_ID repo variable. Only replies from this exact user
# are relayed.
PM_SLACK_MEMBER_ID=

# Plain display name for the same PM above (e.g. "Dominik") - used only to
# attribute the relayed GitHub comment to the real person who answered in
# Slack. Without this, the comment would show up authored by whoever
# SLACK_RELAY_GH_PAT belongs to (a personal token has no separate "posted
# on behalf of" identity), misattributing the PM's actual words.
PM_DISPLAY_NAME=

# Fine-grained GitHub PAT, this repo only, Issues: Read and write - nothing
# else. Never reuse DISPATCH_TOKEN or any Actions secret here (see the plan
# doc's rationale: a broad, Actions-only credential doesn't belong on an
# external VM's disk for a task this narrow).
SLACK_RELAY_GH_PAT=

GITHUB_OWNER=neethumuthu
GITHUB_REPO=BLC-Consortium-MVP

# Where the "already relayed" dedup record persists across restarts.
# Defaults to ./relayed-threads.json if unset.
RELAYED_STORE_PATH=
