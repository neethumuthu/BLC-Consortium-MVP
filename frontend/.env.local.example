# Copy to .env.local (gitignored) and fill in real values.
# API keys must each match the corresponding backend instance's own
# API_KEY (see backend/.env.blcfounder etc.) - generate real random
# values, don't reuse these placeholders.
BLCFOUNDER_API_KEY=replace-with-a-real-random-secret
INSTITUTIONA_API_KEY=replace-with-a-real-random-secret
INSTITUTIONB_API_KEY=replace-with-a-real-random-secret

# Signs/verifies the session JWT - a long random string, unrelated to
# the API keys above.
SESSION_SECRET=replace-with-a-real-random-secret
